@page "/"
@inject LlmService LlmService
@inject ExamCatalogService CatalogService
@inject AnalyticsService AnalyticsService
@inject NavigationManager Navigation

<div class="home-page">
    <div class="hero-section">
        <h1>Exam Simulator</h1>
        <p class="hero-subtitle">AI-powered practice exams for your certification journey</p>
    </div>

    @if (!LlmService.IsConfigured)
    {
        <div class="setup-banner">
            <div class="setup-banner-content">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div>
                    <strong>LLM not configured</strong>
                    <p>Set up your AI provider to start generating practice exams.</p>
                </div>
            </div>
            <button class="primary-btn" @onclick='() => Navigation.NavigateTo("/setup")'>
                Configure AI Provider
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </button>
        </div>
    }
    else
    {
        <div class="llm-status-bar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="9 12 12 15 16 10"/>
            </svg>
            <span>Connected to <strong>@LlmService.CurrentProvider</strong> &mdash; @LlmService.CurrentModel</span>
            <button class="link-btn" @onclick='() => Navigation.NavigateTo("/setup")'>Change</button>
        </div>
    }

    <div class="home-actions">
        <div class="action-card primary-action" @onclick='() => Navigation.NavigateTo("/catalog")'>
            <div class="action-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
                    <line x1="8" y1="7" x2="16" y2="7"/>
                    <line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
            </div>
            <h3>Browse Exams</h3>
            <p>Choose from @(CatalogService.GetAllExams().Count) certification exams across @(CatalogService.GetVendors().Count) vendors</p>
            <span class="action-link">
                Browse catalog
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </span>
        </div>

        <div class="action-card" @onclick='() => Navigation.NavigateTo("/setup")'>
            <div class="action-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
                </svg>
            </div>
            <h3>AI Settings</h3>
            <p>Configure your LLM provider, API key, and model preferences</p>
            <span class="action-link">
                @(LlmService.IsConfigured ? "Update settings" : "Set up now")
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </span>
        </div>

        <div class="action-card" @onclick='() => Navigation.NavigateTo("/history")'>
            <div class="action-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                </svg>
            </div>
            <h3>My Progress</h3>
            <p>@Stats.TotalExamsTaken exams taken &mdash; @Stats.PassRate% pass rate</p>
            <span class="action-link">
                View history
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </span>
        </div>
    </div>

    @if (Stats.RecentAttempts.Count > 0)
    {
        <div class="recent-section">
            <h2>Recent Attempts</h2>
            <div class="recent-list">
                @foreach (var attempt in Stats.RecentAttempts)
                {
                    <div class="recent-item @(attempt.IsPassed ? "passed" : "failed")">
                        <div class="recent-info">
                            <strong>@attempt.ExamTitle</strong>
                            <span class="recent-meta">@attempt.ExamCode &middot; @attempt.StartTime.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="recent-score">
                            <span class="score-badge @(attempt.IsPassed ? "pass" : "fail")">@attempt.ScorePercentage%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private DashboardStats Stats = new();

    protected override async Task OnInitializedAsync()
    {
        await LlmService.InitializeAsync();
        Stats = await AnalyticsService.GetDashboardStatsAsync();
    }
}
