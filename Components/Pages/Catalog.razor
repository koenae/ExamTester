@page "/catalog"
@inject ExamCatalogService CatalogService
@inject LlmService LlmService
@inject NavigationManager Navigation

<div class="catalog-page">
    <div class="page-header">
        <button class="back-btn" @onclick='() => Navigation.NavigateTo("/")'>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back
        </button>
        <h1>Exam Catalog</h1>
        <p class="page-subtitle">Choose a certification exam to practice</p>
    </div>

    @if (!LlmService.IsConfigured)
    {
        <div class="setup-banner">
            <div class="setup-banner-content">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div>
                    <strong>AI provider not configured</strong>
                    <p>You need to set up an LLM provider before generating exams.</p>
                </div>
            </div>
            <button class="primary-btn" @onclick='() => Navigation.NavigateTo("/setup")'>
                Configure Now
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </button>
        </div>
    }

    <div class="catalog-controls">
        <div class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" placeholder="Search exams..." @bind="SearchQuery" @bind:event="oninput" />
        </div>

        <div class="filter-chips">
            <button class="chip @(SelectedVendor == null ? "active" : "")"
                    @onclick="() => SelectedVendor = null">All</button>
            @foreach (var vendor in Vendors)
            {
                <button class="chip @(SelectedVendor == vendor ? "active" : "")"
                        @onclick="() => SelectedVendor = vendor">@vendor</button>
            }
        </div>
    </div>

    <div class="exam-grid">
        @foreach (var exam in FilteredExams)
        {
            <div class="exam-card" @onclick="() => SelectExam(exam)">
                <div class="exam-card-header">
                    <span class="vendor-badge">@exam.Vendor</span>
                    <span class="difficulty-badge @exam.Difficulty.ToLower()">@exam.Difficulty</span>
                </div>
                <h3>@exam.Name</h3>
                <p class="exam-code">@exam.Code</p>
                <p class="exam-desc">@exam.Description</p>
                <div class="exam-card-footer">
                    <div class="exam-stat">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        @exam.TimeLimit min
                    </div>
                    <div class="exam-stat">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 11l3 3L22 4"/>
                            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                        </svg>
                        @exam.QuestionCount questions
                    </div>
                    <div class="exam-stat">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        @exam.PassingScore% to pass
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!FilteredExams.Any())
    {
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <p>No exams found matching your search.</p>
        </div>
    }
</div>

@code {
    private string? SearchQuery;
    private string? SelectedVendor;
    private List<string> Vendors = new();
    private List<ExamCatalogEntry> AllExams = new();

    private IEnumerable<ExamCatalogEntry> FilteredExams
    {
        get
        {
            var exams = AllExams.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedVendor))
                exams = exams.Where(e => e.Vendor == SelectedVendor);

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                var q = SearchQuery.ToLowerInvariant();
                exams = exams.Where(e =>
                    e.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    e.Code.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    e.Description.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return exams;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LlmService.InitializeAsync();
        AllExams = CatalogService.GetAllExams();
        Vendors = CatalogService.GetVendors();
    }

    private void SelectExam(ExamCatalogEntry exam)
    {
        Navigation.NavigateTo($"/exam-setup/{exam.Id}");
    }
}
